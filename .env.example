# Local-only defaults. Replace for personal use; never use these for deployed environments.
WEB_PORT=5173
API_PORT=8080
API2_PORT=8081
POSTGRES_PORT=5432
POSTGRES_DB=cloudresilience
POSTGRES_USER=cloudresilience
POSTGRES_PASSWORD=local-only-change-me
APP_SECURITY_COOKIE_SECURE=false
REDIS_PASSWORD=
APP_SESSION_TIMEOUT=30m
APP_SESSION_REDIS_NAMESPACE=cloudresilience:sessions
APP_PAYMENT_SIMULATOR_OUTCOME=SUCCESS
REDIS_CONNECT_TIMEOUT=2s
REDIS_READ_TIMEOUT=2s
RABBITMQ_USERNAME=cloudresilience
RABBITMQ_PASSWORD=local-only-change-me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VHOST=/
APP_MESSAGING_ENABLED=true
APP_OUTBOX_PUBLISHER_ENABLED=true
APP_MESSAGING_RETRY_TIERS_MS=5000,30000,120000
APP_OUTBOX_PUBLISHER_INTERVAL_MS=1000
APP_OUTBOX_PUBLISHER_BATCH_SIZE=50
APP_OUTBOX_PUBLISHER_MAX_ATTEMPTS=8
